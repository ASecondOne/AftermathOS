# Kconfig fragment appended on top of `x86_64_defconfig` + `kvm_guest.config`
# by `cargo am kernel`. Later lines win, so this is where Aftermath's
# requirements live.
CONFIG_LOCALVERSION="-aftermath"
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# Boot: the whole rootfs is shipped as a zstd initramfs for now.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ISO9660_FS=y
CONFIG_EXT4_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

# QEMU devices
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# virtio-gpu / simpledrm replace the VGA text console during boot. Without
# fbdev emulation + fbcon the screen freezes ("switching to colour dummy device").
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_CLIENT_SELECTION=y
CONFIG_DRM_CLIENT_SETUP=y
CONFIG_DRM_CLIENT_DEFAULT_FBDEV=y
# CONFIG_DRM_FBDEV_LEAK_PHYS_SMEM is not set
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FB_EFI=y
CONFIG_LOGO=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# Init / service manager needs
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y

# Strata (Bedrock-style): namespaces, bind mounts, FUSE for etcfs/crossfs-like
# filesystems, and binfmt_misc for foreign executables (future Windows stratum).
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_FUSE_FS=y
CONFIG_BINFMT_MISC=y
CONFIG_BINFMT_SCRIPT=y

# Landlock: pacman 7's download sandbox (DownloadUser = alpm) restricts the
# downloader with Landlock and aborts every download if the kernel lacks it
# ("restricting filesystem access failed because Landlock is not supported").
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,bpf"

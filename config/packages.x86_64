# Packages pacstrap installs into the Aftermath rootfs (one per line, # = comment).
#
# NOTE: this list intentionally avoids Arch's `base` meta package, because
# `base` pulls in systemd. Some packages still depend on `systemd-libs`
# (libudev etc.); that is only a library, not the init.
filesystem
glibc
bash
coreutils
util-linux
procps-ng
psmisc
shadow
# Authentication policy and existing PAM modules; Aftermath's session module is Rust.
pam
pambase
findutils
grep
sed
gawk
gzip
tar
xz
zstd
file
less
which
nano
kmod
# System message bus, supervised directly by aftermath-engine.
dbus
# Console keymaps + loadkeys (German layout by default, see /etc/aftermath/aftermath.toml)
kbd
iproute2
iputils
pacman
archlinux-keyring
ca-certificates
# Download and unpack optional strata without a container daemon.
skopeo
umoci

# Bootloader (config + theme are added from config/grub by `cargo am`)
grub
efibootmgr

# Network (dhcpcd, started by aftermath-engine), needed by pacman and apt
dhcpcd

# Rescue layer: static BusyBox CLI (copied to /usr/lib/aftermath/rescue)
busybox

# Default graphical environment. The local Plasma sources replace the packaged
# core during image staging; packages supply its coherent runtime dependencies.
plasma-desktop
plasma-integration
sddm
breeze
dolphin
konsole
mesa
qt6-wayland
ttf-dejavu
xorg-xwayland
polkit-kde-agent
